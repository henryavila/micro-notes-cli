#!/usr/bin/env bash
# mn — microNote CLI (human re-entry card for multi-agent work)
# File: MICRONOTE.md (override with MN_FILE)
# Language: MN_LANG / ~/.config/mn/config (pt-BR | en)
set -euo pipefail

MN_VERSION="0.2.0"
DEFAULT_FILE="MICRONOTE.md"
PLACEHOLDER_VALIDAR="- [ ] (nada ainda)"
VALID_ESTADOS="idle|working|blocked|ready"
CONFIG_DIR="${MN_CONFIG_DIR:-$HOME/.config/mn}"
CONFIG_FILE="${MN_CONFIG_FILE:-$CONFIG_DIR/config}"
SHARE_DIR_DEFAULT="${MN_SHARE_DIR:-$HOME/.local/share/mn}"

# ── resolve install / source roots ──────────────────────────────────
_mn_script_path() {
  local src="${BASH_SOURCE[0]}"
  # resolve symlink once (install --link)
  if command -v readlink >/dev/null 2>&1; then
    local t
    t="$(readlink "$src" 2>/dev/null || true)"
    [[ -n "$t" ]] && src="$t"
  fi
  # if still relative, make absolute from cwd at invocation... better: dirname of BASH_SOURCE
  if [[ "$src" != /* ]]; then
    src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    if command -v readlink >/dev/null 2>&1; then
      local t2
      t2="$(readlink "$src" 2>/dev/null || true)"
      [[ -n "$t2" && "$t2" == /* ]] && src="$t2"
      [[ -n "$t2" && "$t2" != /* ]] && src="$(cd "$(dirname "$src")" && cd "$(dirname "$t2")" && pwd)/$(basename "$t2")"
    fi
  fi
  printf '%s\n' "$src"
}

MN_BIN="$(_mn_script_path)"
MN_BIN_DIR="$(cd "$(dirname "$MN_BIN")" && pwd)"

# locales: env → next to repo bin → share dir next to prefix → ~/.local/share/mn
_locales_candidates() {
  local d
  if [[ -n "${MN_LOCALES_DIR:-}" ]]; then
    printf '%s\n' "$MN_LOCALES_DIR"
  fi
  # repo layout: bin/mn → ../locales
  d="$(cd "$MN_BIN_DIR/.." 2>/dev/null && pwd)/locales"
  printf '%s\n' "$d"
  # install layout: ~/.local/bin/mn → ~/.local/share/mn/locales
  d="$(cd "$MN_BIN_DIR/../share/mn" 2>/dev/null && pwd)/locales"
  printf '%s\n' "$d"
  printf '%s\n' "$SHARE_DIR_DEFAULT/locales"
}

find_locales_dir() {
  local d
  while IFS= read -r d; do
    [[ -z "$d" ]] && continue
    if [[ -f "$d/pt-BR.sh" && -f "$d/en.sh" ]]; then
      printf '%s\n' "$d"
      return 0
    fi
  done < <(_locales_candidates)
  return 1
}

# ── language resolution ─────────────────────────────────────────────
# Order: MN_LANG → config file → LANG/LC_ALL heuristic → pt-BR
normalize_lang() {
  local raw="${1:-}"
  raw="$(printf '%s' "$raw" | tr '[:upper:]' '[:lower:]' | tr '_' '-')"
  case "$raw" in
    pt-br|pt|pt-br-*|brazilian*|brasil*) printf 'pt-BR\n' ;;
    en|en-*|english*) printf 'en\n' ;;
    pt-pt|pt-pt-*|portuguese*) 
      # European Portuguese requested → still serve pt-BR (product default BR)
      printf 'pt-BR\n' 
      ;;
    *) printf '%s\n' "" ;;
  esac
}

read_config_lang() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    key="${line%%=*}"
    val="${line#*=}"
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    val="$(printf '%s' "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    if [[ "$key" == "lang" || "$key" == "language" ]]; then
      printf '%s\n' "$val"
      return 0
    fi
  done <"$CONFIG_FILE"
}

detect_lang_from_env() {
  local raw="${LC_ALL:-${LC_MESSAGES:-${LANG:-}}}"
  raw="${raw%%.*}"  # en_US.UTF-8 → en_US
  normalize_lang "$raw"
}

resolve_lang() {
  local n
  if [[ -n "${MN_LANG:-}" ]]; then
    n="$(normalize_lang "$MN_LANG")"
    [[ -n "$n" ]] && { printf '%s\n' "$n"; return; }
  fi
  local cfg
  cfg="$(read_config_lang || true)"
  if [[ -n "$cfg" ]]; then
    n="$(normalize_lang "$cfg")"
    [[ -n "$n" ]] && { printf '%s\n' "$n"; return; }
  fi
  n="$(detect_lang_from_env)"
  if [[ -n "$n" ]]; then
    printf '%s\n' "$n"
    return
  fi
  printf 'pt-BR\n'
}

# ── load locale (with embedded fallback) ────────────────────────────
_load_locale_file() {
  local lang="$1" dir f
  dir="$(find_locales_dir 2>/dev/null || true)"
  [[ -n "$dir" ]] || return 1
  case "$lang" in
    pt-BR) f="$dir/pt-BR.sh" ;;
    en)    f="$dir/en.sh" ;;
    *)     f="$dir/pt-BR.sh" ;;
  esac
  [[ -f "$f" ]] || return 1
  # shellcheck source=/dev/null
  source "$f"
  return 0
}

