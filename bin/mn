#!/usr/bin/env bash
# mn — microNote CLI (human re-entry card for multi-agent work)
# File: MICRONOTE.md (override with MN_FILE)
# UI + file format: English only for now (pt-BR translation later).
# Interactive view: blink TUI via `mn` / `mn ui`. Writes are quiet (one-line ok).
set -euo pipefail

MN_VERSION="0.4.0"
DEFAULT_FILE="MICRONOTE.md"
PLACEHOLDER_VALIDATE="- [ ] (nothing yet)"
# Fallback until Node catalog loads (generic pack is the product default).
VALID_STATUSES="idle|working|blocked|ready"
CONFIG_DIR="${MN_CONFIG_DIR:-$HOME/.config/mn}"
CONFIG_FILE="${MN_CONFIG_FILE:-$CONFIG_DIR/config}"
SHARE_DIR_DEFAULT="${MN_SHARE_DIR:-$HOME/.local/share/mn}"

# ── resolve install / source roots ──────────────────────────────────
_mn_script_path() {
  local src="${BASH_SOURCE[0]}"
  if command -v readlink >/dev/null 2>&1; then
    local t
    t="$(readlink "$src" 2>/dev/null || true)"
    [[ -n "$t" ]] && src="$t"
  fi
  if [[ "$src" != /* ]]; then
    src="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"
    if command -v readlink >/dev/null 2>&1; then
      local t2
      t2="$(readlink "$src" 2>/dev/null || true)"
      [[ -n "$t2" && "$t2" == /* ]] && src="$t2"
      [[ -n "$t2" && "$t2" != /* ]] && src="$(cd "$(dirname "$src")" && cd "$(dirname "$t2")" && pwd)/$(basename "$t2")"
    fi
  fi
  printf '%s\n' "$src"
}

MN_BIN="$(_mn_script_path)"
MN_BIN_DIR="$(cd "$(dirname "$MN_BIN")" && pwd)"
# Repo root: bin/ → parent (works for symlink install --link)
MN_REPO_ROOT="$(cd "$MN_BIN_DIR/.." 2>/dev/null && pwd)"

# ── status catalog (packs: generic|ai-dev + optional statuses.json overlay) ──
# Prefer catalog from config root= (installer), share dir, then symlink/repo layout.
_status_catalog_script() {
  local r cand
  r="${MN_ROOT:-}"
  [[ -z "$r" && -f "$CONFIG_FILE" ]] && r="$(
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "$line" || "$line" == \#* ]] && continue
      case "$line" in
        root=*|MN_ROOT=*)
          printf '%s\n' "${line#*=}" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//'
          break
          ;;
      esac
    done <"$CONFIG_FILE"
  )"
  for cand in \
    "${r:+$r/scripts/status-catalog.mjs}" \
    "${SHARE_DIR_DEFAULT}/scripts/status-catalog.mjs" \
    "${MN_REPO_ROOT}/scripts/status-catalog.mjs" \
    "$MN_BIN_DIR/../scripts/status-catalog.mjs"
  do
    [[ -n "$cand" && -f "$cand" ]] || continue
    printf '%s\n' "$cand"
    return 0
  done
  return 1
}

_status_catalog() {
  local script
  script="$(_status_catalog_script 2>/dev/null || true)"
  if [[ -n "$script" ]]; then
    # MN_ROOT helps the catalog find schemas/packs next to the install root.
    local r_env="${MN_ROOT:-}"
    if [[ -z "$r_env" && -n "$script" ]]; then
      r_env="$(cd "$(dirname "$script")/.." 2>/dev/null && pwd)"
    fi
    MN_ROOT="${r_env:-}" MN_SHARE_DIR="${MN_SHARE_DIR:-$SHARE_DIR_DEFAULT}" \
      node "$script" "$@" 2>/dev/null && return 0
  fi
  # last-resort static fallback = generic pack ids only (pack= still reported if set)
  case "${1:-}" in
    ids) printf '%s\n' "$VALID_STATUSES" ;;
    list) printf '%s\n' idle working blocked ready ;;
    glyph)
      case "${2:-}" in
        idle) printf '○\n' ;; working|coding) printf '◉\n' ;;
        blocked) printf '!\n' ;; ready) printf '►\n' ;;
        *) printf '?\n' ;;
      esac
      ;;
    label) printf '%s\n' "${2:-?}" ;;
    intent)
      case "${2:-}" in
        idle|working|coding|designing|planning) printf 'ignore\n' ;;
        *) printf 'act\n' ;;
      esac
      ;;
    requires-wait) [[ "${2:-}" == "blocked" ]] && printf '1\n' || printf '0\n' ;;
    valid)
      if [[ "${2:-}" =~ ^(idle|working|blocked|ready)$ ]]; then
        printf '1\n'
      else
        printf '0\n'
      fi
      ;;
    canon) printf '%s\n' "${2:-}" ;;
    pack|pack-id)
      # Still honour pack= when the Node catalog is missing.
      local p=""
      if [[ -f "$CONFIG_FILE" ]]; then
        p="$(grep -E '^(pack|MN_PACK)=' "$CONFIG_FILE" 2>/dev/null | head -1 | sed -E 's/^[^=]+=[[:space:]]*//')"
      fi
      p="${MN_PACK:-$p}"
      case "$p" in
        generic|ai-dev) printf '%s\n' "$p" ;;
        *) printf 'generic\n' ;;
      esac
      ;;
    packs)
      printf 'generic\tGeneric\tidle / working / blocked / ready\n'
      printf 'ai-dev\tAI / multi-agent\tdesign → plan → code → review\n'
      ;;
    source) printf 'builtin:generic\n' ;;
    *) return 1 ;;
  esac
}

# Upsert key=value in CONFIG_FILE
_config_set() {
  local key="$1" val="$2"
  mkdir -p "$CONFIG_DIR"
  local tmp
  tmp="$(mktemp)"
  local wrote=0
  if [[ -f "$CONFIG_FILE" ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      if [[ "$line" == "${key}="* ]]; then
        if [[ $wrote -eq 0 ]]; then
          printf '%s=%s\n' "$key" "$val"
          wrote=1
        fi
      else
        printf '%s\n' "$line"
      fi
    done <"$CONFIG_FILE" >"$tmp"
  else
    : >"$tmp"
  fi
  if [[ $wrote -eq 0 ]]; then
    printf '%s=%s\n' "$key" "$val" >>"$tmp"
  fi
  mv -f "$tmp" "$CONFIG_FILE"
}

_statuses_pack_file() {
  local id="${1:-generic}" cand
  for cand in \
    "${MN_REPO_ROOT}/schemas/packs/${id}.json" \
    "${SHARE_DIR_DEFAULT}/schemas/packs/${id}.json" \
    "$MN_BIN_DIR/../schemas/packs/${id}.json"
  do
    if [[ -f "$cand" ]]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

_load_status_catalog() {
  local ids
  ids="$(_status_catalog ids | tr -d '\r')"
  if [[ -n "$ids" && "$ids" == *"|"* ]]; then
    VALID_STATUSES="$ids"
  fi
}
_load_status_catalog

# Shipped pack file for the active pack id (generic default).
_statuses_default_file() {
  local id
  id="$(_status_catalog pack-id 2>/dev/null | tr -d '\r' || true)"
  [[ -z "$id" ]] && id="generic"
  _statuses_pack_file "$id" && return 0
  _statuses_pack_file "generic" && return 0
  local cand
  for cand in \
    "${MN_REPO_ROOT}/schemas/statuses.default.json" \
    "${SHARE_DIR_DEFAULT}/schemas/statuses.default.json" \
    "$MN_BIN_DIR/../schemas/statuses.default.json"
  do
    if [[ -f "$cand" ]]; then
      printf '%s\n' "$cand"
      return 0
    fi
  done
  return 1
}

_statuses_user_file() {
  if [[ -n "${MN_STATUSES:-}" && -n "${MN_STATUSES// }" ]]; then
    printf '%s\n' "$MN_STATUSES"
    return 0
  fi
  printf '%s\n' "$CONFIG_DIR/statuses.json"
}

# ── messages (English only) ─────────────────────────────────────────
ACTIVE_LANG="en"
MN_LANG_NAME="English"

MSG_MISSING_FILE='mn: file not found: %s'
MSG_RUN_INIT='    run: mn init'
MSG_NO_MICRONOTE='mn: no MICRONOTE — run mn init'
MSG_ALREADY_EXISTS='mn: already exists %s'
MSG_CREATED='mn: created %s'
MSG_UNKNOWN_CMD='mn: unknown command: %s'
MSG_SEE_HELP='    mn help'
MSG_INVALID_STATE='mn: invalid status: %s'
MSG_USAGE_THREAD='usage: mn thread <text>              (short thread label)'
MSG_USAGE_TODO='usage: mn todo <text>                 (append Todo checklist item)'
MSG_USAGE_NOW='usage: mn now <text>'
MSG_USAGE_STATUS='usage: mn status <id>   (see: mn status --list; blocked needs reason)'
MSG_USAGE_WAIT='usage: mn wait <text>                 (what is blocking — required when blocked)'
MSG_USAGE_FINISH='usage: mn finish <text>               (settled decision; alias: close)'
MSG_CHECK_MISSING='fail: file not found (%s) — mn init'
MSG_CHECK_HEADING='fail: missing heading ## %s'
MSG_CHECK_STATE_EMPTY='fail: empty status'
MSG_CHECK_STATE_INVALID='fail: invalid status: %s'
MSG_CHECK_THREAD_EMPTY='fail: Thread is empty'
MSG_CHECK_WAIT_EMPTY='fail: status=blocked requires ## Wait (what is blocking) — mn wait "…"'
MSG_CHECK_TODO_EMPTY='fail: Todo empty — add an item or: - [ ] (nothing yet)'
MSG_CHECK_TODO_NO_CB='fail: Todo has no checkboxes — use mn todo "…" or the placeholder'
MSG_CHECK_OK='ok'
MSG_TO_VALIDATE='%s open todo'
MSG_NEEDS_YOU='needs you'
MSG_BLOCKED_ON='blocked on'
MSG_STATUS_BLOCKED_NEEDS_WAIT='mn: status=blocked requires a reason — mn wait "what is blocking" (or: mn status blocked -- "reason")'
MSG_EMPTY='(empty)'
MSG_PLACEHOLDER_BODY='(nothing yet)'
MSG_DASH='—'
MSG_WATCH_HEADER=' mn watch · %ss · Ctrl+C to quit'
MSG_MENU_TODO='todo — what I should verify/decide'
MSG_MENU_THREAD='thread — short thread label'
MSG_MENU_NOW='now — what is happening'
MSG_MENU_STATUS='status — pick from catalog (ai-dev)'
MSG_MENU_WAIT='wait — what is blocking (when blocked)'
MSG_MENU_FINISH='finished — settled decision'
MSG_MENU_DONE='done — mark todo item done'
MSG_MENU_SHOW='show card'
MSG_MENU_UI='ui — blink TUI'
MSG_MENU_CHECK='check'
MSG_MENU_CANCEL='cancel'
MSG_MENU_TITLE='mn +  (menu)'
MSG_MENU_PROMPT='choice [1-%d]: '
MSG_PROMPT_TODO='todo: '
MSG_PROMPT_THREAD='thread (short label): '
MSG_PROMPT_NOW='now: '
MSG_PROMPT_STATUS='status id: '
MSG_PROMPT_WAIT='blocked on (what is blocking): '
MSG_PROMPT_FINISH='finished: '
MSG_PROMPT_DONE='done (n or text, empty=first): '
MSG_FZF_PROMPT='mn › '
MSG_FZF_STATUS='status › '
# help text is built in cmd_help (avoid printf/% and backticks in formats)

msg() {
  local fmt="$1"
  shift
  # shellcheck disable=SC2059
  printf "$fmt" "$@"
}

ok_write() {
  local section="$1"
  shift || true
  local preview="$*"
  if [[ ${#preview} -gt 60 ]]; then
    preview="${preview:0:57}..."
  fi
  if [[ -n "$preview" ]]; then
    printf 'ok · %s · %s\n' "$section" "$preview"
  else
    printf 'ok · %s\n' "$section"
  fi
}

# ── path ────────────────────────────────────────────────────────────
note_path() {
  if [[ -n "${MN_FILE:-}" ]]; then
    printf '%s\n' "$MN_FILE"
  else
    printf '%s\n' "$(pwd)/$DEFAULT_FILE"
  fi
}

NOTE="$(note_path)"

# ── color / symbols ─────────────────────────────────────────────────
use_color() {
  [[ -t 1 ]] || return 1
  [[ -z "${NO_COLOR:-}" ]] || return 1
  [[ "${MN_COLOR:-1}" != "0" ]] || return 1
  [[ "${MN_ASCII:-0}" != "1" ]] || return 1
  return 0
}

if use_color; then
  C_RESET=$'\033[0m'
  C_DIM=$'\033[2m'
  C_BOLD=$'\033[1m'
  C_RED=$'\033[1;31m'
  C_GREEN=$'\033[1;32m'
  C_YELLOW=$'\033[1;33m'
  C_CYAN=$'\033[1;36m'
  C_MAGENTA=$'\033[1;35m'
  C_WHITE=$'\033[1;37m'
else
  C_RESET='' C_DIM='' C_BOLD='' C_RED='' C_GREEN=''
  C_YELLOW='' C_CYAN='' C_MAGENTA='' C_WHITE=''
fi

if [[ "${MN_ASCII:-0}" == "1" ]]; then
  SYM_IDLE='[ ]' SYM_WORKING='[.]' SYM_BLOCKED='[!]' SYM_READY='[>]'
  SYM_THREAD='~' SYM_DESC='=' SYM_NOW='>' SYM_VALIDATE='?' SYM_HUMAN='*' SYM_FINISHED='+'
  SYM_OPEN='[ ]' SYM_DONE='[x]' SYM_BULLET='-'
else
  SYM_IDLE='○' SYM_WORKING='◉' SYM_BLOCKED='⛔' SYM_READY='▶'
  SYM_THREAD='💬' SYM_DESC='∷' SYM_NOW='→' SYM_VALIDATE='☐' SYM_HUMAN='✎' SYM_FINISHED='✓'
  SYM_OPEN='☐' SYM_DONE='☑' SYM_BULLET='•'
fi

now_hm() { date +%H:%M; }

atomic_write() {
  local content="$1"
  local dir tmp
  dir="$(dirname "$NOTE")"
  mkdir -p "$dir"
  tmp="$(mktemp "${dir}/.micronote.XXXXXX")"
  {
    printf '%s' "$content"
    case "$content" in
      *$'\n') ;;
      *) printf '\n' ;;
    esac
  } >"$tmp"
  mv -f "$tmp" "$NOTE"
}

require_note() {
  if [[ ! -f "$NOTE" ]]; then
    msg "$MSG_MISSING_FILE" "$NOTE" >&2
    printf '%s\n' "$MSG_RUN_INIT" >&2
    exit 1
  fi
}

template_body() {
  local t
  t="$(now_hm)"
  cat <<EOF
# microNote
updated: $t
status: idle

## Thread


## Now


## Wait


## Todo
$PLACEHOLDER_VALIDATE

## Finished
- 
EOF
}

# Insert missing ## Heading after a reference heading (or at end before next ##).
_ensure_heading_after() {
  local after_h="$1" new_h="$2"
  grep -qx "$new_h" "$NOTE" 2>/dev/null && return 0
  local content out seen=0 inserted=0 line
  content="$(cat "$NOTE")"
  out=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ $seen -eq 1 && "$line" == "## "* ]]; then
      out+="$new_h"$'\n'$'\n'
      inserted=1
      seen=0
    fi
    [[ "$line" == "$after_h" ]] && seen=1
    out+="$line"$'\n'
  done <<<"$content"
  if [[ $inserted -eq 0 ]]; then
    out+="$new_h"$'\n'$'\n'
  fi
  atomic_write "$out"
}

migrate_note_to_en() {
  [[ -f "$NOTE" ]] || return 0
  local content
  content="$(cat "$NOTE")"

  # PT → EN + Validate/Need → Todo (SCHEMA v0.1)
  content="$(printf '%s\n' "$content" | sed -E \
    -e 's/^atualizado:/updated:/' \
    -e 's/^estado:/status:/' \
    -e 's/^## Fio$/## Thread/' \
    -e 's/^## Agora$/## Now/' \
    -e 's/^## Espera$/## Wait/' \
    -e 's/^## Bloqueio$/## Wait/' \
    -e 's/^## Validar$/## Todo/' \
    -e 's/^## Validate$/## Todo/' \
    -e 's/^## Need$/## Todo/' \
    -e 's/^## Fechado$/## Finished/' \
    -e 's/^## Closed$/## Finished/' \
    -e 's/\(nada ainda\)/(nothing yet)/g')"

  # Drop removed sections (Description / Human and PT aliases) — body discarded.
  content="$(printf '%s\n' "$content" | awk '
    BEGIN { skip=0 }
    /^## (Description|Descricao|Human|Humano)$/ { skip=1; next }
    /^## / { skip=0 }
    skip { next }
    { print }
  ')"

  atomic_write "$content"

  # Ensure Wait exists (after Now)
  if ! grep -qx '## Wait' "$NOTE" 2>/dev/null; then
    _ensure_heading_after "## Now" "## Wait"
  fi
  # Ensure Todo exists (after Wait); seed placeholder if empty section missing entirely
  if ! grep -qx '## Todo' "$NOTE" 2>/dev/null; then
    _ensure_heading_after "## Wait" "## Todo"
    # If Todo body is empty, seed placeholder
    if ! grep -qE '^- \[[ xX]\] ' "$NOTE" 2>/dev/null; then
      # append placeholder under Todo if no checkboxes in file
      replace_section "Todo" "$PLACEHOLDER_VALIDATE" 2>/dev/null || true
    fi
  fi
  # Ensure Finished exists (after Todo)
  if ! grep -qx '## Finished' "$NOTE" 2>/dev/null; then
    _ensure_heading_after "## Todo" "## Finished"
  fi
}

ensure_schema() { migrate_note_to_en; }

cmd_init() {
  if [[ -f "$NOTE" ]]; then
    msg "$MSG_ALREADY_EXISTS" "$NOTE"
    return 0
  fi
  atomic_write "$(template_body)"
  msg "$MSG_CREATED" "$NOTE"
}

get_meta() {
  local a="" e=""
  [[ -f "$NOTE" ]] || { printf '\n\n'; return; }
  a="$(grep -E '^updated:' "$NOTE" | head -1 | sed 's/^updated:[[:space:]]*//')" || true
  e="$(grep -E '^status:' "$NOTE" | head -1 | sed 's/^status:[[:space:]]*//')" || true
  [[ -z "$a" ]] && a="$(grep -E '^atualizado:' "$NOTE" | head -1 | sed 's/^atualizado:[[:space:]]*//')" || true
  [[ -z "$e" ]] && e="$(grep -E '^estado:' "$NOTE" | head -1 | sed 's/^estado:[[:space:]]*//')" || true
  printf '%s\n%s\n' "${a:-}" "${e:-}"
}

set_meta() {
  local key="$1" val="$2"
  require_note
  ensure_schema
  local content
  content="$(cat "$NOTE")"
  if printf '%s\n' "$content" | grep -qE "^${key}:"; then
    content="$(printf '%s\n' "$content" | sed -E "s/^${key}:.*/${key}: ${val}/")"
  else
    content="$(printf '%s\n' "$content" | sed -E "s/^(# microNote)$/\1\n${key}: ${val}/")"
  fi
  atomic_write "$content"
}

touch_time() { set_meta updated "$(now_hm)"; }

extract_section() {
  local name="$1"
  require_note
  awk -v sec="$name" '
    BEGIN { p=0 }
    /^## / {
      if ($0 == "## " sec) { p=1; next }
      else if (p) { exit }
    }
    p { print }
  ' "$NOTE"
}

replace_section() {
  local name="$1"
  local new_body="$2"
  require_note
  ensure_schema
  local content out in_sec=0
  content="$(cat "$NOTE")"
  out=""
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "## $name" ]]; then
      out+="## $name"$'\n'
      out+="$new_body"
      case "$new_body" in
        *$'\n'|'') ;;
        *) out+=$'\n' ;;
      esac
      out+=$'\n'
      in_sec=1
      continue
    fi
    if [[ $in_sec -eq 1 ]]; then
      if [[ "$line" == "## "* ]]; then
        in_sec=0
        out+="$line"$'\n'
      fi
      continue
    fi
    out+="$line"$'\n'
  done <<<"$content"

  if ! printf '%s\n' "$content" | grep -qx "## $name"; then
    out+="## $name"$'\n'
    out+="$new_body"
    case "$new_body" in
      *$'\n'|'') ;;
      *) out+=$'\n' ;;
    esac
    out+=$'\n'
  fi

  atomic_write "$out"
  touch_time
}

append_section_line() {
  local name="$1"
  local line="$2"
  local body
  body="$(extract_section "$name")"
  body="$(printf '%s' "$body" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')"
  if [[ -z "$(printf '%s' "$body" | tr -d '[:space:]')" ]]; then
    body="$line"
  else
    body+=$'\n'"$line"
  fi
  if [[ "$name" == "Todo" ]]; then
    body="$(printf '%s\n' "$body" | grep -vF -- "$PLACEHOLDER_VALIDATE" || true)"
    [[ -z "$(printf '%s' "$body" | tr -d '[:space:]')" ]] && body="$line"
  fi
  if [[ "$name" == "Finished" ]]; then
    body="$(printf '%s\n' "$body" | grep -vE '^-[[:space:]]*$' || true)"
    [[ -z "$(printf '%s' "$body" | tr -d '[:space:]')" ]] && body="$line"
  fi
  replace_section "$name" "$body"
}

cmd_thread() {
  local text="$*"
  [[ -n "$text" ]] || { printf '%s\n' "$MSG_USAGE_THREAD" >&2; exit 2; }
  [[ -f "$NOTE" ]] || cmd_init >/dev/null
  ensure_schema
  replace_section "Thread" "$text"
  ok_write thread "$text"
}

cmd_now() {
  local text="$*"
  [[ -n "$text" ]] || { printf '%s\n' "$MSG_USAGE_NOW" >&2; exit 2; }
  [[ -f "$NOTE" ]] || cmd_init >/dev/null
  ensure_schema
  replace_section "Now" "$text"
  ok_write now "$text"
}

cmd_todo() {
  local text="$*"
  [[ -n "$text" ]] || { printf '%s\n' "$MSG_USAGE_TODO" >&2; exit 2; }
  [[ -f "$NOTE" ]] || cmd_init >/dev/null
  ensure_schema
  append_section_line "Todo" "- [ ] $text"
  ok_write todo "$text"
}

# Aliases: muscle memory
cmd_validate() { cmd_todo "$@"; }
cmd_need() { cmd_todo "$@"; }

cmd_wait() {
  local text="$*"
  [[ -n "$text" ]] || { printf '%s\n' "$MSG_USAGE_WAIT" >&2; exit 2; }
  [[ -f "$NOTE" ]] || cmd_init >/dev/null
  ensure_schema
  replace_section "Wait" "$text"
  ok_write wait "$text"
}

cmd_status() {
  local val="${1:-}"
  local reason=""

  # ── catalog management (no note write) ────────────────────────────
  case "$val" in
    --list|list|-l)
      local id g lab intent
      while IFS= read -r id; do
        [[ -z "$id" ]] && continue
        g="$(_status_catalog glyph "$id")"
        lab="$(_status_catalog label "$id")"
        intent="$(_status_catalog intent "$id")"
        printf '  %s %-14s  %s  [%s]\n' "$g" "$id" "$lab" "$intent"
      done < <(_status_catalog list)
      return 0
      ;;
    --show|show|path|--path)
      local src user def pack_id
      pack_id="$(_status_catalog pack-id 2>/dev/null | tr -d '\r' || true)"
      src="$(_status_catalog source 2>/dev/null | tr -d '\r' || true)"
      user="$(_statuses_user_file)"
      def="$(_statuses_default_file 2>/dev/null || true)"
      printf 'active pack:  %s\n' "${pack_id:-generic}"
      printf 'pack source:  %s\n' "${src:-builtin/fallback}"
      printf 'user overlay: %s' "$user"
      if [[ -f "$user" && -z "${MN_STATUSES:-}" ]]; then
        printf '  (exists — merged on top of pack)\n'
      elif [[ -n "${MN_STATUSES:-}" && -f "${MN_STATUSES}" ]]; then
        printf '  (MN_STATUSES path override)\n'
      else
        printf '  (none)\n'
      fi
      printf 'pack file:    %s\n' "${def:-(not found)}"
      printf 'config:       %s  (pack=…)\n' "$CONFIG_FILE"
      printf '\nEffective statuses:\n'
      cmd_status --list
      return 0
      ;;
    pack|--pack)
      shift || true
      local sub="${1:-}"
      case "$sub" in
        ""|show)
          printf '%s\n' "$(_status_catalog pack-id 2>/dev/null | tr -d '\r' || echo generic)"
          return 0
          ;;
        list|--list|-l)
          local line id label desc
          printf 'Built-in status packs:\n'
          while IFS=$'\t' read -r id label desc; do
            [[ -z "$id" ]] && continue
            local mark=" "
            [[ "$id" == "$(_status_catalog pack-id 2>/dev/null | tr -d '\r')" ]] && mark="*"
            printf '  %s %-10s  %s\n' "$mark" "$id" "$label"
            [[ -n "$desc" ]] && printf '               %s\n' "$desc"
          done < <(_status_catalog packs)
          printf '\n* = active   set: mn status pack <id>\n'
          printf 'user overlay: mn status init  →  edit ~/.config/mn/statuses.json\n'
          return 0
          ;;
        generic|ai-dev)
          if ! _statuses_pack_file "$sub" >/dev/null 2>&1; then
            printf 'mn: pack file not found for %s\n' "$sub" >&2
            exit 1
          fi
          _config_set pack "$sub"
          # bust any cached env
          printf 'mn: status pack → %s\n' "$sub"
          printf '    config: %s\n' "$CONFIG_FILE"
          printf '    list:   mn status --list\n'
          return 0
          ;;
        help|--help)
          cat <<'EOF'
mn status pack — choose built-in status set

  mn status pack              print active pack id
  mn status pack list         list built-in packs (* = active)
  mn status pack generic      native: idle · working · blocked · ready
  mn status pack ai-dev       AI stages: design → plan → code → review

Personal overlay (optional): mn status init → edit statuses.json
Full path override: MN_STATUSES=/path/to.json  or  statuses= in config
EOF
          return 0
          ;;
        *)
          printf 'mn: unknown pack %s — try: mn status pack list\n' "$sub" >&2
          exit 2
          ;;
      esac
      ;;
    --init|init)
      local force=0 dest src
      shift || true
      [[ "${1:-}" == "--force" || "${1:-}" == "-f" ]] && force=1
      dest="$CONFIG_DIR/statuses.json"
      mkdir -p "$(dirname "$dest")"
      if [[ -f "$dest" && $force -eq 0 ]]; then
        printf 'mn: already exists %s\n' "$dest" >&2
        printf '    edit it, or: mn status init --force\n' >&2
        printf '    active: mn status show\n' >&2
        exit 1
      fi
      src="$(_statuses_default_file)" || {
        printf 'mn: cannot find pack JSON under schemas/packs/\n' >&2
        exit 1
      }
      cp "$src" "$dest"
      printf 'mn: wrote user overlay %s\n' "$dest"
      printf '    (merged on top of pack=%s)\n' "$(_status_catalog pack-id 2>/dev/null | tr -d '\r' || echo generic)"
      printf '    edit labels/order/statuses, then: mn status --list\n'
      printf '    every status needs intent ignore|act; blocked should set requiresWait: true\n'
      return 0
      ;;
    --edit|edit)
      local dest
      dest="$CONFIG_DIR/statuses.json"
      if [[ ! -f "$dest" ]]; then
        printf 'mn: no user overlay at %s\n' "$dest" >&2
        printf '    run: mn status init\n' >&2
        exit 1
      fi
      local ed="${EDITOR:-${VISUAL:-vi}}"
      # shellcheck disable=SC2086
      $ed "$dest"
      printf 'mn: edited %s — verify with: mn status --list\n' "$dest"
      return 0
      ;;
    --help|help)
      cat <<'EOF'
mn status — set card status, or manage status packs

Set status on the card
  mn status <id>
  mn status blocked -- "what is blocking"

Built-in packs
  mn status pack list         generic (default) · ai-dev
  mn status pack generic      native 4 statuses
  mn status pack ai-dev       design → plan → code → review
  mn status show              active pack + paths + list

Personal overlay (optional)
  mn status init              copy active pack → ~/.config/mn/statuses.json
  mn status init --force      overwrite overlay
  mn status edit              $EDITOR on overlay
  mn status --list            effective statuses after merge

Resolution
  1. $MN_STATUSES file (full base override)
  2. statuses= path in ~/.config/mn/config
  3. Built-in pack from pack= in config (default: generic)
  4. Deep-merge ~/.config/mn/statuses.json if present

Custom overlay tips
  - Each status: intent (ignore|act), glyph, label, optional badge
  - requiresWait: true → ## Wait required
  - Partial overlay: only patch statuses you change (deep-merge by id)
  - "order" in overlay replaces the full picker order
EOF
      return 0
      ;;
  esac

  # ── set status on the note ────────────────────────────────────────
  # mn status blocked -- "reason"  OR  mn status blocked "reason…"
  if [[ "$val" == "blocked" ]]; then
    shift || true
    if [[ "${1:-}" == "--" ]]; then
      shift || true
    fi
    reason="$*"
  else
    shift || true
  fi
  [[ -n "$val" ]] || { printf '%s\n' "$MSG_USAGE_STATUS" >&2; printf '    mn status help\n' >&2; exit 2; }
  if [[ "$(_status_catalog valid "$val")" != "1" ]]; then
    msg "$MSG_INVALID_STATE" "$val" >&2
    printf '    valid: %s\n' "$VALID_STATUSES" >&2
    printf '    (mn status --list | mn status help)\n' >&2
    exit 2
  fi
  val="$(_status_catalog canon "$val" | tr -d '\r')"
  [[ -f "$NOTE" ]] || cmd_init >/dev/null
  ensure_schema
  local needs_wait
  needs_wait="$(_status_catalog requires-wait "$val" | tr -d '\r')"
  if [[ "$needs_wait" == "1" ]]; then
    if [[ -z "$reason" ]]; then
      local existing
      existing="$(extract_section "Wait" 2>/dev/null | tr -d '[:space:]' || true)"
      if [[ -z "$existing" ]]; then
        printf '%s\n' "$MSG_STATUS_BLOCKED_NEEDS_WAIT" >&2
        exit 2
      fi
    else
      replace_section "Wait" "$reason"
    fi
  else
    # Leaving requiresWait clears the wait reason
    replace_section "Wait" ""
  fi
  set_meta status "$val"
  touch_time
  if [[ "$needs_wait" == "1" && -n "$reason" ]]; then
    ok_write status "$val · $reason"
  else
    ok_write status "$val"
  fi
}

cmd_finish() {
  local text="$*"
  [[ -n "$text" ]] || { printf '%s\n' "$MSG_USAGE_FINISH" >&2; exit 2; }
  [[ -f "$NOTE" ]] || cmd_init >/dev/null
  ensure_schema
  append_section_line "Finished" "- $text"
  ok_write finish "$text"
}

# Alias — muscle memory from pre-Finished SCHEMA name
cmd_close() { cmd_finish "$@"; }

cmd_clear_todo() {
  [[ -f "$NOTE" ]] || cmd_init >/dev/null
  ensure_schema
  replace_section "Todo" "$PLACEHOLDER_VALIDATE"
  ok_write clear-todo
}

cmd_clear_validate() { cmd_clear_todo "$@"; }
cmd_clear_need() { cmd_clear_todo "$@"; }

cmd_touch() {
  require_note
  ensure_schema
  touch_time
  ok_write touch
}

cmd_done() {
  require_note
  ensure_schema
  local arg="${*:-}"
  local body new_body
  body="$(extract_section "Todo")"
  if [[ -z "$arg" ]]; then
    new_body="$(printf '%s\n' "$body" | awk '
      !done && /^- \[ \] / { sub(/^- \[ \] /, "- [x] "); done=1 }
      { print }
    ')"
  elif [[ "$arg" =~ ^[0-9]+$ ]]; then
    local n="$arg"
    new_body="$(printf '%s\n' "$body" | awk -v n="$n" '
      /^- \[[ xX]\] / { i++ }
      i==n && /^- \[ \] / { sub(/^- \[ \] /, "- [x] ") }
      { print }
    ')"
  else
    new_body="$(printf '%s\n' "$body" | awk -v t="$arg" '
      !done && /^- \[ \] / && index($0, t) {
        sub(/^- \[ \] /, "- [x] "); done=1
      }
      { print }
    ')"
  fi
  replace_section "Todo" "$(printf '%s\n' "$new_body" | sed -e :a -e '/^\n*$/{$d;N;ba' -e '}')"
  ok_write done "${arg:-first}"
}

cmd_check() {
  local errs=0
  if [[ ! -f "$NOTE" ]]; then
    msg "$MSG_CHECK_MISSING" "$NOTE"
    exit 1
  fi
  ensure_schema
  local meta updated status
  meta="$(get_meta)"
  updated="$(printf '%s\n' "$meta" | sed -n '1p')"
  status="$(printf '%s\n' "$meta" | sed -n '2p')"

  for h in Thread Now Wait Todo Finished; do
    if ! grep -qx "## $h" "$NOTE"; then
      msg "$MSG_CHECK_HEADING" "$h"
      errs=1
    fi
  done

  if [[ -z "$status" ]]; then
    printf '%s\n' "$MSG_CHECK_STATE_EMPTY"
    errs=1
  elif [[ "$(_status_catalog valid "$status")" != "1" ]]; then
    msg "$MSG_CHECK_STATE_INVALID" "$status"
    errs=1
  fi

  local thread
  thread="$(extract_section "Thread" | tr -d '[:space:]')"
  if [[ -z "$thread" ]]; then
    printf '%s\n' "$MSG_CHECK_THREAD_EMPTY"
    errs=1
  fi

  if [[ "$(_status_catalog requires-wait "$status")" == "1" ]]; then
    local wait_body
    wait_body="$(extract_section "Wait" 2>/dev/null | tr -d '[:space:]' || true)"
    if [[ -z "$wait_body" ]]; then
      printf '%s\n' "$MSG_CHECK_WAIT_EMPTY"
      errs=1
    fi
  fi

  local val_body open_items has_placeholder
  val_body="$(extract_section "Todo")"
  has_placeholder=0
  printf '%s\n' "$val_body" | grep -qF -- "$PLACEHOLDER_VALIDATE" && has_placeholder=1
  open_items="$(printf '%s\n' "$val_body" | grep -cE -- '^- \[[ xX]\] ' || true)"
  if [[ "$has_placeholder" -eq 0 && "$open_items" -eq 0 ]]; then
    if [[ -z "$(printf '%s' "$val_body" | tr -d '[:space:]')" ]]; then
      printf '%s\n' "$MSG_CHECK_TODO_EMPTY"
      errs=1
    else
      printf '%s\n' "$MSG_CHECK_TODO_NO_CB"
      errs=1
    fi
  fi

  if [[ $errs -ne 0 ]]; then
    exit 1
  fi
  printf '%s\n' "$MSG_CHECK_OK"
}

count_open_validate() {
  # Count real open items only — exclude the empty-state placeholder so
  # `status: ready` + only "- [ ] (nothing yet)" does not show "1 open todo".
  extract_section "Todo" 2>/dev/null \
    | grep -E -- '^- \[ \] ' \
    | grep -vF -- "$PLACEHOLDER_VALIDATE" \
    | grep -vF -- '- [ ] (nada ainda)' \
    | grep -c . || true
}

# Returns 0 if section has non-whitespace body (placeholder validate counts as empty).
_section_nonempty() {
  local name="$1"
  local body line
  body="$(extract_section "$name" 2>/dev/null || true)"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$(printf '%s' "$line" | tr -d '[:space:]')" ]] && continue
    [[ "$line" =~ ^-[[:space:]]*$ ]] && continue
    if [[ "$name" == "Todo" ]]; then
      [[ "$line" == "- [ ] (nothing yet)" || "$line" == "- [ ] (nada ainda)" ]] && continue
    fi
    if [[ "$name" == "Finished" && "$line" == "-" ]]; then
      continue
    fi
    return 0
  done <<<"$body"
  return 1
}

# Short block: icon + colored label + body. Prints nothing if empty.
# Pass required=1 as 7th arg to always print (Thread) — empty body → dim hint.
_print_short_block() {
  local name="$1" label="$2" icon="$3" color="$4" indent="${5:-     }"
  local body_color="${6:-$C_RESET}" required="${7:-0}"
  local body line has=0
  if _section_nonempty "$name"; then
    has=1
  elif [[ "$required" != "1" ]]; then
    return 0
  fi
  body="$(extract_section "$name" 2>/dev/null || true)"
  printf '  %s%s %s%s\n' "$color" "$icon" "$label" "$C_RESET"
  if [[ $has -eq 1 ]]; then
    while IFS= read -r line || [[ -n "$line" ]]; do
      [[ -z "$(printf '%s' "$line" | tr -d '[:space:]')" ]] && continue
      printf '%s%s%s%s\n' "$indent" "$body_color" "$line" "$C_RESET"
    done <<<"$body"
  else
    # Required but empty — keep card from going blank (not a generic "(empty)")
    printf '%s%sset with t%s\n' "$indent" "$C_DIM" "$C_RESET"
  fi
  # Optional 8th arg: skip trailing blank so a continuation (e.g. details) can sit flush.
  if [[ "${8:-0}" != "1" ]]; then
    printf '\n'
  fi
}

_print_todo() {
  local body line t open_n=0
  _section_nonempty "Todo" || return 0
  body="$(extract_section "Todo" 2>/dev/null || true)"
  # count open for badge on label
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ "$line" == "- [ ] "* ]] || continue
    t="$(printf '%s\n' "$line" | sed -E 's/^- \[ \] //')"
    [[ "$t" == "(nothing yet)" || "$t" == "(nada ainda)" ]] && continue
    open_n=$((open_n + 1))
  done <<<"$body"

  local vcolor="$C_GREEN"
  local status
  status="$(get_meta | sed -n '2p')"
  [[ "$status" == "ready" || "$status" == "blocked" ]] && vcolor="$C_BOLD$C_GREEN"
  if [[ "$open_n" -gt 0 ]]; then
    printf '  %s%s todo%s %s· %s open%s\n' "$vcolor" "$SYM_VALIDATE" "$C_RESET" "$C_DIM" "$open_n" "$C_RESET"
  else
    printf '  %s%s todo%s\n' "$vcolor" "$SYM_VALIDATE" "$C_RESET"
  fi
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$(printf '%s' "$line" | tr -d '[:space:]')" ]] && continue
    if [[ "$line" == "- [x] "* || "$line" == "- [X] "* ]]; then
      t="$(printf '%s\n' "$line" | sed -E 's/^- \[[xX]\] //')"
      printf '     %s%s  %s%s\n' "$C_DIM" "$SYM_DONE" "$t" "$C_RESET"
    elif [[ "$line" == "- [ ] "* ]]; then
      t="$(printf '%s\n' "$line" | sed -E 's/^- \[ \] //')"
      [[ "$t" == "(nothing yet)" || "$t" == "(nada ainda)" ]] && continue
      printf '     %s%s  %s%s\n' "$C_GREEN" "$SYM_OPEN" "$t" "$C_RESET"
    else
      printf '     %s\n' "$line"
    fi
  done <<<"$body"
  printf '\n'
}

_print_finished() {
  local body line
  _section_nonempty "Finished" || return 0
  body="$(extract_section "Finished" 2>/dev/null || true)"
  printf '  %s%s finished%s\n' "$C_DIM" "$SYM_FINISHED" "$C_RESET"
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$(printf '%s' "$line" | tr -d '[:space:]')" ]] && continue
    [[ "$line" =~ ^-[[:space:]]*$ ]] && continue
    if [[ "$line" == "- "* ]]; then
      printf '     %s%s %s%s\n' "$C_DIM" "$SYM_BULLET" "${line#- }" "$C_RESET"
    else
      printf '     %s%s%s\n' "$C_DIM" "$line" "$C_RESET"
    fi
  done <<<"$body"
  printf '\n'
}

_show_missing() {
  printf '%s\n' "${C_DIM}${MSG_NO_MICRONOTE}${C_RESET}"
}

_show_card() {
  local meta updated status
  meta="$(get_meta)"
  updated="$(printf '%s\n' "$meta" | sed -n '1p')"
  status="$(printf '%s\n' "$meta" | sed -n '2p')"
  [[ -z "$status" ]] && status="?"

  local sym color open_n badge="" intent
  sym="$(_status_catalog glyph "$status" | tr -d '\r')"
  intent="$(_status_catalog intent "$status" | tr -d '\r')"
  case "$intent" in
    act)
      if [[ "$status" == "blocked" || "$(_status_catalog requires-wait "$status")" == "1" ]]; then
        color="$C_RED"
      elif [[ "$status" == "ready" ]]; then
        color="$C_GREEN"
      else
        color="$C_YELLOW"
      fi
      ;;
    *) color="$C_DIM" ;;
  esac
  # busy coding-like stages stand out a bit
  case "$status" in
    coding|designing|planning|working) color="$C_YELLOW" ;;
  esac
  [[ -z "$sym" || "$sym" == "?" ]] && case "$status" in
    idle) sym="$SYM_IDLE" ;; working|coding) sym="$SYM_WORKING" ;;
    blocked) sym="$SYM_BLOCKED" ;; ready) sym="$SYM_READY" ;;
  esac

  open_n="$(count_open_validate)"
  local wait_text="" badge_cat
  badge_cat="$(_status_catalog badge "$status" | tr -d '\r')"
  if [[ "$(_status_catalog requires-wait "$status")" == "1" ]]; then
    wait_text="$(extract_section "Wait" 2>/dev/null | sed -e '/^[[:space:]]*$/d' | head -1 || true)"
  fi
  if [[ "$status" == "ready" && "$open_n" -gt 0 ]]; then
    badge="  ${C_GREEN}$(msg "$MSG_TO_VALIDATE" "$open_n")${C_RESET}"
  elif [[ "$(_status_catalog requires-wait "$status")" == "1" ]]; then
    if [[ -n "$wait_text" ]]; then
      badge="  ${C_RED}${badge_cat:-$MSG_NEEDS_YOU} · ${wait_text}${C_RESET}"
    else
      badge="  ${C_RED}${badge_cat:-$MSG_NEEDS_YOU} · set: mn wait \"…\"${C_RESET}"
    fi
  elif [[ -n "$badge_cat" && "$intent" == "act" ]]; then
    badge="  ${C_YELLOW}${badge_cat}${C_RESET}"
  fi

  local short_path
  short_path="$(basename "$(dirname "$NOTE")")/$(basename "$NOTE")"

  printf '\n'
  printf '  %s%s %s%s  %s·%s  %s  %s·%s  %s%s%s\n' \
    "$color" "$sym" "$status" "$C_RESET" \
    "$C_DIM" "$C_RESET" \
    "${updated:---}" \
    "$C_DIM" "$C_RESET" \
    "$C_DIM" "$short_path" "$C_RESET"
  if [[ -n "$badge" ]]; then
    printf '%s\n' "$badge"
  fi
  printf '\n'

  # Blocked-on first when status requires wait — answers "what stops this stream".
  if [[ "$(_status_catalog requires-wait "$status")" == "1" ]]; then
    _print_short_block "Wait" "$MSG_BLOCKED_ON" "!" "$C_RED" "     " "$C_WHITE" 1
  fi

  # Thread is always shown (required). Other blocks omit when empty.
  _print_short_block "Thread" "thread" "$SYM_THREAD" "$C_CYAN" "     " "$C_WHITE" 1
  _print_short_block "Now" "now" "$SYM_NOW" "$C_YELLOW" "     " "$C_WHITE"
  _print_todo
  _print_finished
}

cmd_show() {
  if [[ ! -f "$NOTE" ]]; then
    _show_missing
    return 0
  fi
  ensure_schema
  _show_card
}

cmd_watch() {
  local interval="${MN_WATCH_INTERVAL:-1}"
  if [[ "${1:-}" =~ ^[0-9]+$ ]]; then
    interval="$1"
  fi
  while true; do
    if command -v clear >/dev/null 2>&1; then
      clear
    else
      printf '\033[2J\033[H'
    fi
    # shellcheck disable=SC2059
    printf "${C_DIM}${MSG_WATCH_HEADER}${C_RESET}\n" "$interval"
    cmd_show || true
    sleep "$interval"
  done
}

cmd_path() { printf '%s\n' "$NOTE"; }

cmd_lang() {
  if [[ -n "${1:-}" ]]; then
    printf 'mn: UI is English-only for now (got: %s). pt-BR later.\n' "$1" >&2
    exit 2
  fi
  printf 'en (%s)\n' "${MN_LANG_NAME:-English}"
}

cmd_help() {
  cat <<EOF
mn v${MN_VERSION} — microNote (human re-entry card)

File: ${DEFAULT_FILE}  (override: MN_FILE)
Path:     $(note_path)

Read
  mn              open TUI on a TTY (else one-shot card)
  mn ui           blink TUI (live card + keys)
  mn show         one-shot card (no TUI)
  mn watch [n]    refresh every n seconds (default 1)
  mn path         print file path
  mn check        validate structure (exit 0/1)
  mn help         this help

Write (quiet — one-line ok; use TUI or mn show for the card)
  mn init
  mn thread <text>
  mn now <text>
  mn wait <text>              what is blocking (required when blocked)
  mn todo <text>              append Todo checklist item
  mn validate <text>          alias → todo
  mn status <id>              set status (from active pack)
  mn status --list            list statuses (glyph · id · label · intent)
  mn status pack list|generic|ai-dev   built-in status sets
  mn status show              active pack + paths
  mn status init [--force]    personal overlay → ~/.config/mn/statuses.json
  mn status edit              open user overlay in $EDITOR
  mn status help              packs + overlay docs
  mn status blocked -- <reason>   set blocked + wait in one shot
  mn finish <text>            settled decision (alias: close)
  mn done [n|text]
  mn clear-todo
  mn touch
  mn +            interactive menu

Status packs
  generic (default)  idle · working · blocked · ready
  ai-dev             design → plan → code → review
  select:  mn status pack list | mn status pack <id>
  TUI:     ,  (settings)
  overlay: mn status init → ~/.config/mn/statuses.json
  path:    MN_STATUSES=…  or  statuses= in config

Shortcuts
  t→thread  n→now  w→wait  v→todo  s→status  f→finish

Env
  MN_FILE  MN_COLOR=0  NO_COLOR  MN_ASCII=1  MN_WATCH_INTERVAL
  MN_UI=0             force one-shot card for bare mn
  MN_ROOT             repo root (TUI discovery)
  MN_TUI_LAUNCHER     path to tui/bin/mn-ui.mjs

Herdr: side pane →  mn ui   (or mn watch)
EOF
}

_read_config_root() {
  [[ -f "$CONFIG_FILE" ]] || return 0
  local line key val
  while IFS= read -r line || [[ -n "$line" ]]; do
    [[ -z "$line" || "$line" == \#* ]] && continue
    key="${line%%=*}"
    val="${line#*=}"
    key="$(printf '%s' "$key" | tr -d '[:space:]')"
    val="$(printf '%s' "$val" | sed -e 's/^[[:space:]]*//' -e 's/[[:space:]]*$//')"
    if [[ "$key" == "root" || "$key" == "MN_ROOT" ]]; then
      printf '%s\n' "$val"
      return 0
    fi
  done <"$CONFIG_FILE"
}

_mn_repo_root() {
  # Prefer config (install --link writes root=…), then env, then bin parent.
  local r
  r="${MN_ROOT:-}"
  [[ -z "$r" ]] && r="$(_read_config_root || true)"
  if [[ -z "$r" ]]; then
    r="$(cd "$MN_BIN_DIR/.." 2>/dev/null && pwd)"
  fi
  printf '%s\n' "$r"
}

_find_ui_launcher() {
  local root cand
  root="$(_mn_repo_root)"
  for cand in \
    "${MN_TUI_LAUNCHER:-}" \
    "$root/tui/bin/mn-ui.mjs" \
    "$SHARE_DIR_DEFAULT/tui/bin/mn-ui.mjs" \
    "$MN_BIN_DIR/../tui/bin/mn-ui.mjs"
  do
    [[ -n "$cand" && -f "$cand" ]] && { printf '%s\n' "$cand"; return 0; }
  done
  return 1
}

cmd_ui() {
  local root launcher pkg_root
  local fallback="${1:-}" # "fallback" → show card instead of exit 1 on missing TUI
  root="$(_mn_repo_root)"
  launcher="$(_find_ui_launcher || true)"
  if [[ -z "$launcher" || ! -f "$launcher" ]]; then
    printf 'mn: TUI launcher not found\n' >&2
    printf '    install with: cd <micro-notes-cli> && ./install.sh --link && npm install\n' >&2
    printf '    or set MN_ROOT / MN_TUI_LAUNCHER\n' >&2
    if [[ "$fallback" == "fallback" ]]; then
      printf 'mn: falling back to one-shot card (mn show)\n' >&2
      cmd_show
      return
    fi
    exit 1
  fi
  if ! command -v node >/dev/null 2>&1; then
    printf 'mn: node >= 18 is required for the TUI\n' >&2
    if [[ "$fallback" == "fallback" ]]; then
      printf 'mn: falling back to one-shot card (mn show)\n' >&2
      cmd_show
      return
    fi
    exit 1
  fi
  # node_modules next to package root (parent of tui/)
  pkg_root="$(cd "$(dirname "$launcher")/../.." 2>/dev/null && pwd)"
  if [[ ! -d "$pkg_root/node_modules/ink" ]]; then
    printf 'mn: installing TUI dependencies in %s…\n' "$pkg_root" >&2
    if ! (cd "$pkg_root" && npm install --no-fund --no-audit); then
      printf 'mn: npm install failed\n' >&2
      if [[ "$fallback" == "fallback" ]]; then
        printf 'mn: falling back to one-shot card (mn show)\n' >&2
        cmd_show
        return
      fi
      exit 1
    fi
  fi
  export MN_FILE="${MN_FILE:-$NOTE}"
  exec node "$launcher"
}

cmd_menu() {
  local options=(
    "$MSG_MENU_UI"
    "$MSG_MENU_TODO"
    "$MSG_MENU_THREAD"
    "$MSG_MENU_NOW"
    "$MSG_MENU_STATUS"
    "$MSG_MENU_WAIT"
    "$MSG_MENU_FINISH"
    "$MSG_MENU_DONE"
    "$MSG_MENU_SHOW"
    "$MSG_MENU_CHECK"
    "$MSG_MENU_CANCEL"
  )
  local choice=""
  if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
    choice="$(printf '%s\n' "${options[@]}" | fzf --prompt="$MSG_FZF_PROMPT" --height=40% --reverse || true)"
  else
    printf '%s\n' "$MSG_MENU_TITLE"
    local i=1
    for o in "${options[@]}"; do
      printf '  %d) %s\n' "$i" "$o"
      i=$((i + 1))
    done
    # shellcheck disable=SC2059
    printf "$MSG_MENU_PROMPT" "${#options[@]}"
    local n
    read -r n || true
    if [[ "$n" =~ ^[0-9]+$ ]] && (( n >= 1 && n <= ${#options[@]} )); then
      choice="${options[$((n - 1))]}"
    fi
  fi
  [[ -z "$choice" || "$choice" == "$MSG_MENU_CANCEL"* || "$choice" == cancel* ]] && return 0
  local text=""
  case "$choice" in
    ui*|*"blink"*) cmd_ui ;;
    todo*|need*|validate*|*"what I should"*|*"verify"*)
      printf '%s' "$MSG_PROMPT_TODO"; read -r text
      [[ -n "$text" ]] && cmd_todo "$text"
      ;;
    thread*|*"short thread"*)
      printf '%s' "$MSG_PROMPT_THREAD"; read -r text
      [[ -n "$text" ]] && cmd_thread "$text"
      ;;
    now*|*"happening"*)
      printf '%s' "$MSG_PROMPT_NOW"; read -r text
      [[ -n "$text" ]] && cmd_now "$text"
      ;;
    status*)
      local est
      if command -v fzf >/dev/null 2>&1 && [[ -t 0 ]]; then
        est="$(_status_catalog list | fzf --prompt="$MSG_FZF_STATUS" --height=40% --reverse || true)"
      else
        _status_catalog list | nl -ba
        printf '%s' "$MSG_PROMPT_STATUS"; read -r est
      fi
      if [[ -n "$est" ]]; then
        if [[ "$(_status_catalog requires-wait "$est")" == "1" ]]; then
          printf '%s' "$MSG_PROMPT_WAIT"; read -r text
          [[ -n "$text" ]] && cmd_status "$est" -- "$text"
        else
          cmd_status "$est"
        fi
      fi
      ;;
    wait*|*"blocking"*)
      printf '%s' "$MSG_PROMPT_WAIT"; read -r text
      [[ -n "$text" ]] && cmd_wait "$text"
      ;;
    finish*|close*|*"finished"*|*"closed"*)
      printf '%s' "$MSG_PROMPT_FINISH"; read -r text
      [[ -n "$text" ]] && cmd_finish "$text"
      ;;
    done*|*"mark todo"*|*"mark need"*|*"mark validate"*)
      printf '%s' "$MSG_PROMPT_DONE"; read -r text
      # shellcheck disable=SC2086
      cmd_done $text
      ;;
    show*) cmd_show ;;
    check*) cmd_check ;;
  esac
}

main() {
  local cmd="${1:-}"
  if [[ $# -gt 0 ]]; then shift; fi

  case "$cmd" in
    --watch) cmd="watch" ;;
    --help|-h) cmd="help" ;;
    --version|-V) printf '%s\n' "$MN_VERSION"; exit 0 ;;
    --path) cmd="path" ;;
    --lang) cmd="lang" ;;
    --ui) cmd="ui" ;;
    --show) cmd="show" ;;
  esac

  if [[ -z "$cmd" ]]; then
    if [[ -t 1 && "${MN_UI:-1}" != "0" ]]; then
      # Prefer TUI; if launcher/node/deps missing, show card instead of hard-failing.
      cmd_ui fallback
      return
    fi
    cmd_show
    return
  fi

  case "$cmd" in
    t) cmd="thread" ;;
    n) cmd="now" ;;
    w) cmd="wait" ;;
    v|e) cmd="todo" ;;
    s) cmd="status" ;;
    f) cmd="finish" ;;
    +) cmd="menu" ;;
  esac

  case "$cmd" in
    init)            cmd_init ;;
    show)            cmd_show ;;
    ui|tui)          cmd_ui ;;
    watch)           cmd_watch "$@" ;;
    path)            cmd_path ;;
    check)           cmd_check ;;
    help)            cmd_help ;;
    lang)            cmd_lang "$@" ;;
    thread)          cmd_thread "$@" ;;
    now)             cmd_now "$@" ;;
    wait|blocked-on) cmd_wait "$@" ;;
    todo|need)       cmd_todo "$@" ;;
    validate)        cmd_validate "$@" ;;
    status)          cmd_status "$@" ;;
    finish|close)    cmd_finish "$@" ;;
    done)            cmd_done "$@" ;;
    clear-todo|clear-need|clear-validate) cmd_clear_todo ;;
    touch)           cmd_touch ;;
    menu)            cmd_menu ;;
    *)
      msg "$MSG_UNKNOWN_CMD" "$cmd" >&2
      printf '%s\n' "$MSG_SEE_HELP" >&2
      exit 2
      ;;
  esac
}

main "$@"
